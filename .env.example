# Copy the lines you need into your REAL .env file (never this one) and fill
# them in there. .env is never included in the zips I send you and is never
# overwritten by a redeploy — config.js and every other .js file WILL be
# overwritten every time, so don't put real keys directly in config.js.
#
# After editing .env you MUST restart the bot process — env vars are only
# read once, at startup (index.js calls dotenv.config() on line 14).
#
# If you're on a hosting panel (Pterodactyl, Railway, etc.) check whether it
# has its own separate "Variables"/"Environment" tab — some panels inject
# their own env vars at container start, which silently override or ignore
# whatever is in this file.

# ── AI providers (all optional — chain skips whichever aren't set) ────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
AI_PROVIDER_ORDER=claude,openai,gemini,deepseek

# ── Third-party relay/tool APIs (all optional) ─────────────────────────────
SAVAGE_API_KEY=
REMOVEBG_API_KEY=
YTDLP_COOKIES_FILE=

# ── Core bot settings ───────────────────────────────────────────────────
SESSION_ID=
PHONE_NUMBER=
OWNER_NUMBER=
BOT_NAME=MAHNGUELOH VANTA
OWNER_NAME=MAHNGUELOH
MODE=public
